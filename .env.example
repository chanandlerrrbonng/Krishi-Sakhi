# Copy this file to `.env` at the ask-it repo root and fill in real values.
#   cp .env.example .env
# Never commit `.env` — it is listed in `.gitignore`.

# --- Vayu Vector DB (Qdrant) — Step 2 ---
QDRANT_URL=
QDRANT_API_KEY=
COLLECTION_NAME=knowledge_base_rag
# QDRANT_PATH=
# QDRANT_PORT=

# --- Vayu Model as a Service — Step 3 ---
OPENAI_BASE_URL=
LLM_OPENAI_API_KEY=
CHAT_MODEL=
EMBEDDING_OPENAI_API_KEY=
EMBEDDING_MODEL=
# EMBED_BATCH_SIZE=

# --- Vayu Object Storage (optional) — Step 1 ---
VAYU_S3_KEY=
VAYU_S3_SECRET=
VAYU_S3_ENDPOINT=
VAYU_S3_BUCKET=

# --- Vayu Container Registry (Step 6 — build, sign, deploy) ---
# Host only — do not include https://, http://, or a trailing /
IMAGE_REGISTRY=
REGISTRY_PROJECT=
REGISTRY_USERNAME=
REGISTRY_PASSWORD=
VAYU_USERNAME=
